{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"lib": ["ES2022"],
		"types": ["node", "../../node_modules/bun-types"]
	},
	"include": ["api/**/*.ts", "dev.ts", "scripts/build.ts"]
}
