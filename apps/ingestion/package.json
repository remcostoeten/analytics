{
	"name": "@remcostoeten/ingestion-deploy",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run dev.ts",
		"build": "bun run scripts/build.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "bun run --cwd ../../packages/ingestion test",
		"db:generate": "bun run --cwd ../../packages/ingestion db:generate",
		"db:migrate": "bun run --cwd ../../packages/ingestion db:migrate",
		"db:studio": "drizzle-kit studio --config ../../packages/ingestion/drizzle.config.ts",
		"db:seed": "bun run ../../packages/ingestion/src/db/seed.ts",
		"ops": "bun run scripts/ops.ts",
		"ops:build": "bun build --compile --outfile dist/analytics-ops scripts/ops.ts"
	},
	"dependencies": {
		"@remcostoeten/ingestion": "workspace:*",
		"@neondatabase/serverless": "^0.10.0",
		"drizzle-orm": "^0.36.0",
		"hono": "4.6.10",
		"ua-parser-js": "^2.0.9",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"bun-types": "^1.3.9",
		"drizzle-kit": "^0.31.9",
		"typescript": "5.6.3"
	}
}
