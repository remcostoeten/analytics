{
	"name": "@spoar/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./app": "./src/app.ts",
		"./geo": "./src/geo.ts"
	},
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"dev:worker": "wrangler dev",
		"deploy:worker": "wrangler deploy --var COMMIT_SHA:$(git rev-parse HEAD)",
		"build": "bun scripts/download-geo.ts",
		"typecheck": "tsgo --noEmit",
		"test": "bun test",
		"openapi": "bun scripts/openapi.ts"
	},
	"dependencies": {
		"@elysiajs/openapi": "1.4.16",
		"@sinclair/typebox": "catalog:typebox",
		"@spoar/contract": "workspace:*",
		"@spoar/engine": "workspace:*",
		"@spoar/shared": "workspace:*",
		"better-auth": "1.7.6",
		"drizzle-orm": "0.45.3",
		"elysia": "1.4.30"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261018.1",
		"@electric-sql/pglite": "0.5.8",
		"wrangler": "4.151.1"
	}
}
