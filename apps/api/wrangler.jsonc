{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spoar-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.analytics.remcostoeten.nl", "custom_domain": true }],
  "vars": {
    "NODE_ENV": "production"
  }
}
