# The v2 API the dashboard reads from and signs in through. Set DASHBOARD_ORIGIN on that API to the
# origin the browser sees: the landing site that rewrites /dashboard here, or this app's own origin
# when it runs alone. Otherwise sign-in and the session cookie are refused.
NEXT_PUBLIC_API_URL=http://localhost:3100
# The landing and docs site the dashboard links back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
