# The browser SDK options for this site's own tracking: its project, public key and the proxy path.
NEXT_PUBLIC_RA_CONFIG='{"project":"docs.analytics.remcostoeten.nl","key":"pk_...","endpoint":"/_ra"}'
# The project's secret key, which the /_ra proxy adds before forwarding events to the API.
RA_SECRET=sk_...
# The v2 API. The landing page reads this site's public stats from it, and the query page starts with it.
NEXT_PUBLIC_API_URL=https://api.analytics.remcostoeten.nl
