{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "v1/**"
  ],
  "ignore": [
    ".agents/**",
    "tools/oxlint/anti-slop/**"
  ],
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "scripts/*.ts"
      ]
    },
    "e2e": {
      "entry": [
        "tests/*.spec.ts",
        "parity/*.test.ts",
        "site/app.ts"
      ]
    },
    "examples/dashboard": {
      "entry": [
        "src/main.tsx",
        "steps/*/src/**/*.{ts,tsx}"
      ]
    },
    "packages/debugtools": {
      "entry": [
        "scripts/*.ts"
      ],
      "ignore": [
        "src/styles/console.css"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    }
  },
  "ignoreExportsUsedInFile": {
    "type": true
  }
}
