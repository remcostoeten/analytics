{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "data/**"]
		},
		"styles": {
			"outputs": ["src/styles/compiled.ts"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"cache": false
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"serve": {
			"cache": false,
			"persistent": true
		}
	}
}
