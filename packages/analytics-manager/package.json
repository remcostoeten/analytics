{
	"name": "@remcostoeten/analytics-manager",
	"version": "0.1.0",
	"description": "Typed, fluent analytics orchestration layer on top of @remcostoeten/analytics, PostHog and Vercel Analytics",
	"keywords": [
		"adapters",
		"analytics",
		"nextjs",
		"orchestration",
		"posthog",
		"react",
		"typescript",
		"vercel"
	],
	"license": "MIT",
	"author": "Remco Stoeten",
	"repository": {
		"type": "git",
		"url": "https://github.com/remcostoeten/analytics",
		"directory": "packages/analytics-manager"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react/index.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/index.d.ts",
				"default": "./dist/react/index.js"
			},
			"require": {
				"types": "./dist/react/index.d.cts",
				"default": "./dist/react/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsup",
		"dev": "tsup --watch",
		"typecheck": "tsgo --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@remcostoeten/analytics": "workspace:*",
		"@types/node": "^25.2.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vercel/analytics": "^1.0.0",
		"bun-types": "^1.3.9",
		"posthog-js": "^1.0.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@remcostoeten/analytics": "^1.7.0",
		"@vercel/analytics": "^1.0.0",
		"posthog-js": "^1.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@remcostoeten/analytics": {
			"optional": true
		},
		"@vercel/analytics": {
			"optional": true
		},
		"posthog-js": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
