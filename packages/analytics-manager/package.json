{
	"name": "@remcostoeten/analytics-manager",
	"version": "0.1.0",
	"description": "Typed, fluent analytics orchestration layer on top of @remcostoeten/analytics, PostHog and Vercel Analytics",
	"keywords": [
		"adapters",
		"analytics",
		"orchestration",
		"posthog",
		"typescript",
		"vercel"
	],
	"license": "MIT",
	"author": "Remco Stoeten",
	"repository": {
		"type": "git",
		"url": "https://github.com/remcostoeten/analytics",
		"directory": "packages/analytics-manager"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsgo --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@types/node": "^25.2.3",
		"bun-types": "^1.3.9",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@remcostoeten/analytics": "^1.7.0",
		"@vercel/analytics": "^1.0.0",
		"posthog-js": "^1.0.0"
	},
	"peerDependenciesMeta": {
		"@remcostoeten/analytics": {
			"optional": true
		},
		"@vercel/analytics": {
			"optional": true
		},
		"posthog-js": {
			"optional": true
		}
	}
}
