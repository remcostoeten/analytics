{
	"name": "@remcostoeten/ingestion",
	"version": "0.1.0",
	"description": "Self-hosted analytics ingestion service for Remco Analytics",
	"keywords": [
		"analytics",
		"hono",
		"ingestion",
		"postgres",
		"privacy"
	],
	"license": "MIT",
	"author": "Remco Stoeten",
	"repository": {
		"type": "git",
		"url": "https://github.com/remcostoeten/analytics",
		"directory": "packages/ingestion"
	},
	"files": [
		"dist",
		"src/db/migrations",
		"drizzle.config.ts",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./vercel": {
			"types": "./dist/vercel.d.ts",
			"import": "./dist/vercel.js",
			"require": "./dist/vercel.cjs"
		},
		"./drizzle.config": "./drizzle.config.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"dev": "bun run --cwd ../../apps/ingestion dev",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit up:pg",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.4.4",
		"@neondatabase/serverless": "^0.10.0",
		"@types/node": "^20.10.0",
		"@types/ua-parser-js": "^0.7.39",
		"bun-types": "^1.3.9",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.36.0",
		"hono": "4.6.10",
		"tsup": "^8.5.1",
		"typescript": "5.6.3",
		"ua-parser-js": "^2.0.9",
		"zod": "^3.22.4"
	},
	"peerDependencies": {
		"@neondatabase/serverless": "^0.10.0",
		"drizzle-orm": "^0.36.0",
		"hono": "^4.6.0",
		"ua-parser-js": "^2.0.0",
		"zod": "^3.22.0"
	}
}
