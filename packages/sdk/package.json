{
	"name": "@spoar/sdk",
	"version": "2.0.0-next.1",
	"description": "Privacy-first analytics for browsers, servers and React: typed events, batching, consent and plugins.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remcostoeten/analytics.git",
		"directory": "packages/sdk"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./plugins": {
			"types": "./src/plugins/index.ts",
			"default": "./src/plugins/index.ts"
		},
		"./react": {
			"types": "./src/react/index.ts",
			"default": "./src/react/index.ts"
		},
		"./next": {
			"types": "./src/next/index.tsx",
			"default": "./src/next/index.tsx"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"default": "./src/server/index.ts"
		},
		"./proxy": {
			"types": "./src/proxy/index.ts",
			"default": "./src/proxy/index.ts"
		},
		"./admin": {
			"types": "./src/admin/index.ts",
			"default": "./src/admin/index.ts"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./plugins": {
				"types": "./dist/plugins.d.mts",
				"default": "./dist/plugins.mjs"
			},
			"./react": {
				"types": "./dist/react.d.mts",
				"default": "./dist/react.mjs"
			},
			"./next": {
				"types": "./dist/next.d.mts",
				"default": "./dist/next.mjs"
			},
			"./server": {
				"types": "./dist/server.d.mts",
				"default": "./dist/server.mjs"
			},
			"./proxy": {
				"types": "./dist/proxy.d.mts",
				"default": "./dist/proxy.mjs"
			},
			"./admin": {
				"types": "./dist/admin.d.mts",
				"default": "./dist/admin.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsgo --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"web-vitals": "6.2.2"
	},
	"peerDependencies": {
		"next": ">=15",
		"react": ">=19"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "20.14.5",
		"@sinclair/typebox": "catalog:typebox",
		"@spoar/contract": "workspace:*",
		"@spoar/shared": "workspace:*",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"next": "16.4.0-canary.59",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tsdown": "catalog:tsdown"
	}
}
