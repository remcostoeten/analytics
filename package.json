{
	"name": "remco-analytics",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@oxlint/plugins": "catalog:oxlint",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"bun-types": "^1.3.9",
		"knip": "6.38.0",
		"lefthook": "2.1.14",
		"oxfmt": "catalog:oxfmt",
		"oxlint": "catalog:oxlint",
		"oxlint-tsgolint": "catalog:oxlint",
		"sherif": "1.13.0",
		"typescript": "catalog:ts"
	},
	"catalogs": {
		"ts": {
			"typescript": "5.6.3"
		},
		"oxlint": {
			"oxlint": "1.85.0",
			"@oxlint/plugins": "1.85.0",
			"oxlint-tsgolint": "7.0.2003"
		},
		"oxfmt": {
			"oxfmt": "0.70.0"
		},
		"typebox": {
			"@sinclair/typebox": "0.34.52"
		},
		"tsdown": {
			"tsdown": "0.23.0"
		}
	},
	"private": true,
	"scripts": {
		"build": "bun run --filter '*' build",
		"test": "bun run --filter './v1/**' --sequential test && bun run --filter './apps/*' --filter './examples/*' --filter './packages/*' --filter './scripts' --filter './tools/oxlint/*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"test:e2e": "bun run --cwd e2e test:e2e",
		"lint": "oxlint --type-aware --deny-warnings apps examples packages tools scripts e2e && bun run lint:v1",
		"lint:fix": "oxlint --type-aware --fix apps examples packages tools scripts e2e",
		"lint:v1": "oxlint -c v1/.oxlintrc.json --deny-warnings v1",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"boundaries": "bun scripts/check-boundaries.ts",
		"deps": "sherif",
		"knip": "knip",
		"knip:v1": "knip --config knip.v1.json --no-exit-code",
		"changeset": "changeset",
		"migrate": "bun scripts/migrate.ts",
		"rescore": "bun scripts/rescore.ts",
		"size": "bun scripts/size-check.ts",
		"release": "bun scripts/publish.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run boundaries && bun run deps && bun run knip && bun run test",
		"dev": "bun run --cwd v1/apps/dashboard dev",
		"dev:ingestion": "bun run --cwd v1/apps/ingestion dev",
		"demo:db": "bun run v1/scripts/demo-db/setup.ts"
	},
	"workspaces": [
		"apps/*",
		"e2e",
		"examples/*",
		"packages/*",
		"scripts",
		"tools/oxlint/house",
		"v1/apps/*",
		"v1/packages/*"
	],
	"sherif": {
		"ignorePackage": [
			"./v1/apps/*",
			"./v1/packages/*"
		]
	},
	"overrides": {
		"undici": "7.30.0"
	},
	"patchedDependencies": {
		"@elysiajs/openapi@1.4.16": "patches/@elysiajs%2Fopenapi@1.4.16.patch"
	}
}
