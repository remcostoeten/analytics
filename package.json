{
    "name": "remco-analytics",
    "version": "0.0.1",
    "devDependencies": {
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "bun-types": "^1.3.9",
        "oxfmt": "catalog:oxfmt",
        "oxlint": "catalog:oxlint",
        "shadcn": "^4.13.1",
        "typescript": "catalog:ts"
    },
    "catalogs": {
        "ts": {
            "typescript": "5.6.3"
        },
        "hono": {
            "hono": "4.6.10"
        },
        "oxlint": {
            "oxlint": "0.10.0"
        },
        "oxfmt": {
            "oxfmt": "0.45.0"
        },
        "drizzle": {
            "drizzle-orm": "^0.36.0",
            "drizzle-kit": "^0.31.9"
        },
        "neon": {
            "@neondatabase/serverless": "^0.10.0"
        }
    },
    "private": true,
    "scripts": {
        "build": "bun run --filter '*' build",
        "test": "bun run --filter '*' test",
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "oxlint v1/apps v1/packages --deny-warnings",
        "fmt": "oxfmt v1/apps v1/packages '!**/dist/**' '!**/.next/**'",
        "fmt:check": "oxfmt --check v1/apps v1/packages '!**/dist/**' '!**/.next/**'",
        "dev": "bun run --cwd v1/apps/dashboard dev",
        "dev:ingestion": "bun run --cwd v1/apps/ingestion dev",
        "demo:db": "bun run v1/scripts/demo-db/setup.ts"
    },
    "workspaces": [
        "apps/*",
        "packages/*",
        "v1/apps/*",
        "v1/packages/*"
    ]
}
