{
	"name": "remco-analytics",
	"version": "0.0.1",
	"type": "module",
	"devDependencies": {
		"@oxlint/plugins": "catalog:oxlint",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"bun-types": "^1.3.9",
		"lefthook": "2.1.14",
		"oxfmt": "catalog:oxfmt",
		"oxlint": "catalog:oxlint",
		"oxlint-tsgolint": "catalog:oxlint",
		"shadcn": "^4.13.1",
		"typescript": "catalog:ts"
	},
	"catalogs": {
		"ts": {
			"typescript": "5.6.3"
		},
		"hono": {
			"hono": "4.6.10"
		},
		"oxlint": {
			"oxlint": "1.85.0",
			"@oxlint/plugins": "1.85.0",
			"oxlint-tsgolint": "7.0.2003"
		},
		"oxfmt": {
			"oxfmt": "0.70.0"
		},
		"drizzle": {
			"drizzle-orm": "^0.36.0",
			"drizzle-kit": "^0.31.9"
		},
		"neon": {
			"@neondatabase/serverless": "^0.10.0"
		},
		"typebox": {
			"typebox": "1.3.34"
		},
		"tsdown": {
			"tsdown": "0.23.0"
		}
	},
	"private": true,
	"scripts": {
		"build": "bun run --filter '*' build",
		"test": "bun run --filter './v1/**' test && bun run --filter './packages/*' --filter './scripts' --filter './tools/oxlint/*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "oxlint --type-aware --deny-warnings apps packages tools scripts e2e && bun run lint:v1",
		"lint:fix": "oxlint --type-aware --fix apps packages tools scripts e2e",
		"lint:v1": "oxlint -c v1/.oxlintrc.json --deny-warnings v1",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"boundaries": "bun scripts/check-boundaries.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run boundaries && bun run test",
		"dev": "bun run --cwd v1/apps/dashboard dev",
		"dev:ingestion": "bun run --cwd v1/apps/ingestion dev",
		"demo:db": "bun run v1/scripts/demo-db/setup.ts"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"scripts",
		"tools/oxlint/*",
		"v1/apps/*",
		"v1/packages/*"
	]
}
